{% doc %}
  Renders a Véra shop-by-category card (image, title, link).

  @param {object} collection - Collection to display
  @param {image} [image_override] - Optional custom image instead of the collection image
  @param {string} [shopify_attributes] - Optional theme editor attributes from a section block

  @example
  {% render 'vera-collection-card', collection: collection %}

  @example
  {% render 'vera-collection-card',
    collection: block.settings.collection,
    image_override: block.settings.image,
    shopify_attributes: block.shopify_attributes
  %}
{% enddoc %}

{% if collection == blank and request.design_mode %}
  <div class="vera-category-card vera-category-card--placeholder" {{ shopify_attributes }}>
    <div class="vera-category-card__image">
      {{ 'collection-1' | placeholder_svg_tag }}
    </div>
    <div class="vera-category-card__info">
      <h3>{{ 'sections.vera_shop_by_category.select_collection' | t }}</h3>
    </div>
  </div>
{% elsif collection != blank %}
{% liquid
  assign card_image = image_override
  if card_image == blank
    assign card_image = collection.featured_image
  endif
  if card_image == blank
    assign card_image = collection.image
  endif
%}

<a
  href="{{ collection.url }}"
  class="vera-category-card"
  {{ shopify_attributes }}
>
  <div class="vera-category-card__image">
    {% if card_image != blank %}
      {{
        card_image
        | image_url: width: 900
        | image_tag:
          loading: 'lazy',
          widths: '300, 500, 700, 900',
          sizes: '(max-width: 749px) 80vw, 33vw',
          alt: collection.title
      }}
    {% else %}
      {{ 'collection-1' | placeholder_svg_tag }}
    {% endif %}
  </div>

  <div class="vera-category-card__info">
    <h3>{{ collection.title | escape }}</h3>
    <span aria-hidden="true">↗</span>
  </div>
</a>
{% endif %}
