
{% comment %}
  Receives:
  - block: collection card block
{% endcomment %}

{% assign category = block.settings.collection %}
{% assign card_image = block.settings.image | default: category.image %}

{% if category != blank %}
  <a
    href="{{ category.url }}"
    class="vera-category-card"
    {{ block.shopify_attributes }}
  >
    <div class="vera-category-card__image">
      {% if card_image != blank %}
        {{
          card_image
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            widths: '300, 500, 700, 900',
            sizes: '(max-width: 749px) 80vw, 33vw'
        }}
      {% else %}
        {{ 'collection-1' | placeholder_svg_tag }}
      {% endif %}
    </div>

    <div class="vera-category-card__info">
      <h3>{{ category.title | escape }}</h3>
      <span aria-hidden="true">↗</span>
    </div>
  </a>
{% endif %}
