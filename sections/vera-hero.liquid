
<section
  class="vera-hero"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="vera-hero__content">
    {% if section.settings.eyebrow != blank %}
      <p class="vera-hero__eyebrow">
        {{ section.settings.eyebrow | escape }}
      </p>
    {% endif %}

    <h1 class="vera-hero__heading">
      {{ section.settings.heading | escape }}
    </h1>

    <div class="vera-hero__description">
      {{ section.settings.description }}
    </div>

    {% if section.settings.button_link != blank %}
      <a
        href="{{ section.settings.button_link }}"
        class="vera-hero__button"
      >
        {{ section.settings.button_label | escape }}
        <span aria-hidden="true">→</span>
      </a>
    {% endif %}
  </div>

  <div class="vera-hero__image">
    {% if section.settings.hero_image != blank %}
      {{
        section.settings.hero_image
        | image_url: width: 1600
        | image_tag:
          loading: 'eager',
          widths: '400, 600, 800, 1200, 1600',
          sizes: '(max-width: 749px) 100vw, 50vw'
      }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .vera-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 650px;
  }

  .vera-hero__content {
    padding: 80px clamp(24px, 6vw, 100px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
  }

  .vera-hero__eyebrow {
    font-size: 12px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #977d65;
    margin-bottom: 24px;
  }

  .vera-hero__heading {
    font-family: Georgia, serif;
    font-size: clamp(42px, 5vw, 78px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 28px;
  }

  .vera-hero__description {
    font-size: 16px;
    line-height: 1.8;
    color: #666;
    max-width: 420px;
    margin-bottom: 36px;
  }

  .vera-hero__button {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    padding: 16px 28px;
    background: #282824;
    color: #fff;
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .vera-hero__image {
    min-height: 650px;
    overflow: hidden;
  }

  .vera-hero__image img,
  .vera-hero__image svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 749px) {
    .vera-hero {
      grid-template-columns: 1fr;
    }

    .vera-hero__content {
      padding: 70px 24px;
    }

    .vera-hero__image {
      min-height: 400px;
      height: 400px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vera Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "THE NEW COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "Style that feels like you."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover timeless essentials designed for effortless everyday dressing.</p>"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Shop New Arrivals"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F4F0EB"
    }
  ],
  "presets": [
    {
      "name": "Vera Hero"
    }
  ]
}
{% endschema %}
