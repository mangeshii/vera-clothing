
<section
  class="vera-hero"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="vera-hero__content">
    {% if section.settings.eyebrow != blank %}
      <p class="vera-hero__eyebrow">
        {{ section.settings.eyebrow | escape }}
      </p>
    {% endif %}

    <h1 class="vera-hero__heading">
      {{ section.settings.heading | escape }}
    </h1>

    <div class="vera-hero__description">
      {{ section.settings.description }}
    </div>

    {% if section.settings.button_link != blank %}
      <a
        href="{{ section.settings.button_link }}"
        class="vera-hero__button"
      >
        {{ section.settings.button_label | escape }}
        <span aria-hidden="true">→</span>
      </a>
    {% endif %}
  </div>

  <div class="vera-hero__image">
    {% if section.settings.hero_image != blank %}
      {{
        section.settings.hero_image
        | image_url: width: 1600
        | image_tag:
          loading: 'eager',
          widths: '400, 600, 800, 1200, 1600',
          sizes: '(max-width: 749px) 100vw, 50vw',
          alt: section.settings.heading
      }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {% endif %}
  </div>
</section>

{{ 'vera-hero.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Vera Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "THE NEW COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "Style that feels like you."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover timeless essentials designed for effortless everyday dressing.</p>"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image",
      "info": "Saved on the theme in Theme Editor. If the image vanishes after refresh while using theme dev, ensure templates/index.json is in .shopifyignore so local empty JSON does not overwrite your upload."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Shop New Arrivals"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F4F0EB"
    }
  ],
  "presets": [
    {
      "name": "Vera Hero"
    }
  ]
}
{% endschema %}
