
<section
  class="vera-image-text"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="vera-image-text__container {% if section.settings.image_position == 'right' %}vera-image-text--reverse{% endif %}">

    <div class="vera-image-text__visual">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 1200',
            sizes: '(max-width: 749px) 100vw, 50vw',
            alt: section.settings.heading
        }}
      {% else %}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {% endif %}
    </div>

    <div class="vera-image-text__content">
      {% if section.settings.eyebrow != blank %}
        <p class="vera-image-text__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      <h2>{{ section.settings.heading | escape }}</h2>

      <div class="vera-image-text__description">
        {{ section.settings.description }}
      </div>

      {% if section.settings.button_link != blank and section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}" class="vera-image-text__button">
          {{ section.settings.button_label | escape }}
          <span aria-hidden="true">→</span>
        </a>
      {% endif %}
    </div>

  </div>
</section>

{% stylesheet %}
  .vera-image-text {
    padding: 90px 24px;
  }

  .vera-image-text__container {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(32px, 6vw, 100px);
  }

  .vera-image-text--reverse .vera-image-text__visual {
    order: 2;
  }

  .vera-image-text__visual {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #eae5df;
  }

  .vera-image-text__visual img,
  .vera-image-text__visual svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .vera-image-text__eyebrow {
    color: #977d65;
    font-size: 12px;
    letter-spacing: 3px;
    text-transform: uppercase;
  }

  .vera-image-text__content h2 {
    font-family: Georgia, serif;
    font-size: clamp(36px, 4vw, 60px);
    font-weight: 400;
    line-height: 1.15;
    margin: 20px 0;
  }

  .vera-image-text__description {
    color: #666;
    line-height: 1.8;
    font-size: 16px;
  }

  .vera-image-text__button {
    display: inline-flex;
    gap: 20px;
    margin-top: 30px;
    color: #292724;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1px;
  }

  @media (max-width: 749px) {
    .vera-image-text {
      padding: 60px 16px;
    }

    .vera-image-text__container {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .vera-image-text--reverse .vera-image-text__visual {
      order: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vera Image with Text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "OUR PHILOSOPHY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "Less, but better."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>We believe great style comes from thoughtful details, comfortable fabrics, and timeless designs.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button text",
      "default": "Discover Our Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#F4F0EB"
    }
  ],
  "presets": [
    {
      "name": "Vera Image with Text"
    }
  ]
}
{% endschema %}
