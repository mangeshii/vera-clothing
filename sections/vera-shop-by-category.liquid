
<section class="vera-categories" id="vera-categories-{{ section.id }}">
  <div class="vera-categories__container">
    <div class="vera-categories__header">
      <p>{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>

    <div class="vera-categories__grid">
      {% for block in section.blocks %}
        {% if block.type == 'collection_card' %}
          {% render 'vera-collection-card', block: block %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .vera-categories {
    padding: 90px 24px;
    background: #f9f7f4;
  }

  .vera-categories__container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .vera-categories__header {
    text-align: center;
    margin-bottom: 45px;
  }

  .vera-categories__header p {
    font-size: 12px;
    letter-spacing: 3px;
    color: #977d65;
    text-transform: uppercase;
  }

  .vera-categories__header h2 {
    font-family: Georgia, serif;
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 400;
    margin: 12px 0;
  }

  .vera-categories__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .vera-category-card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .vera-category-card__image {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #eae5df;
  }

  .vera-category-card__image img,
  .vera-category-card__image svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .vera-category-card:hover img {
    transform: scale(1.05);
  }

  .vera-category-card__info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 18px;
  }

  .vera-category-card__info h3 {
    font-size: 20px;
    font-weight: 500;
    margin: 0;
  }

  @media (max-width: 749px) {
    .vera-categories {
      padding: 60px 16px;
    }

    .vera-categories__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vera Shop by Category",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "EXPLORE VERA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "Shop by Category"
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Collection Card",
      "limit": 6,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom category image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vera Shop by Category",
      "blocks": [
        {"type": "collection_card"},
        {"type": "collection_card"},
        {"type": "collection_card"}
      ]
    }
  ]
}
{% endschema %}
