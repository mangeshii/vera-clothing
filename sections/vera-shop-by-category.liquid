
<section class="vera-categories" id="vera-categories-{{ section.id }}">
  <div class="vera-categories__container">
    <div class="vera-categories__header">
      <p>{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>

    <div class="vera-categories__grid">
      {% liquid
        assign excluded_handles = section.settings.excluded_handles | split: ','
        assign shown_count = 0
        assign collections_limit = section.settings.collections_limit | default: 12
        assign hide_empty = section.settings.hide_empty_collections | default: true
      %}

      {% paginate collections by 250 %}
        {% for collection in collections %}
          {% if shown_count >= collections_limit %}
            {% break %}
          {% endif %}

          {% liquid
            assign skip_collection = false

            for handle_part in excluded_handles
              assign excluded_handle = handle_part | strip
              if excluded_handle != blank
                if collection.handle == excluded_handle
                  assign skip_collection = true
                endif
              endif
            endfor

            if hide_empty
              if collection.all_products_count == 0
                assign skip_collection = true
              endif
            endif
          %}

          {% unless skip_collection %}
            {% liquid
              assign image_override = blank
              for block in section.blocks
                if block.type == 'collection_card'
                  assign block_collection = block.settings.collection
                  if block_collection != blank
                    if block_collection.handle == collection.handle
                      if block.settings.image != blank
                        assign image_override = block.settings.image
                      endif
                      break
                    endif
                  endif
                endif
              endfor
            %}

            {% render 'vera-collection-card',
              collection: collection,
              image_override: image_override
            %}
            {% assign shown_count = shown_count | plus: 1 %}
          {% endunless %}
        {% endfor %}
      {% endpaginate %}

      {% if shown_count == 0 and request.design_mode %}
        <p class="vera-categories__empty">
          {{ 'sections.vera_shop_by_category.no_collections' | t }}
        </p>
      {% endif %}
    </div>
  </div>
</section>

{{ 'vera-shop-by-category.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Vera Shop by Category",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "EXPLORE VERA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "Shop by Category"
    },
    {
      "type": "range",
      "id": "collections_limit",
      "label": "Maximum collections to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "hide_empty_collections",
      "label": "Hide collections with no products",
      "default": true
    },
    {
      "type": "textarea",
      "id": "excluded_handles",
      "label": "Excluded collection handles",
      "default": "frontpage, build-your-own-box",
      "info": "Comma-separated handles not shown as categories (e.g. internal builder collection). Find handle under Collection → Search engine listing."
    }
  ],
  "blocks": [
    {
      "type": "collection_card",
      "name": "Custom category image",
      "limit": 24,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom category image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vera Shop by Category"
    }
  ]
}
{% endschema %}
