
{% assign featured_collection = section.settings.collection %}

<section class="vera-featured-products">
  <div class="vera-featured-products__container">
    <div class="vera-featured-products__header">
      <p>{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>

    {% if featured_collection != blank %}
      <div class="vera-featured-products__grid vera-product-grid">


{% for product in featured_collection.products limit: section.settings.product_limit %}
  {% render 'vera-product-card', product: product %}
{% endfor %}


      </div>
    {% else %}
      <p>Select a collection in the Theme Editor.</p>
    {% endif %}
  </div>
</section>

{{ 'vera-product-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vera-color-swatches.js' | asset_url }}" defer></script>

{% stylesheet %}
  .vera-featured-products {
    padding: 90px 24px;
    background: #fff;
  }

  .vera-featured-products__container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .vera-featured-products__header {
    text-align: center;
    margin-bottom: 45px;
  }

  .vera-featured-products__header p {
    font-size: 12px;
    letter-spacing: 3px;
    color: #977d65;
  }

  .vera-featured-products__header h2 {
    font-family: Georgia, serif;
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 400;
    margin: 12px 0;
  }

  .vera-featured-products__grid {
    --vera-grid-columns-desktop: 3;
    --vera-grid-columns-tablet: 2;
    --vera-grid-columns-mobile: 2;
  }

  @media (max-width: 749px) {
    .vera-featured-products {
      padding: 60px 16px;
    }

  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vera Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "THE VERA EDIT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "New Arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Number of products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Vera Featured Products"
    }
  ]
}
{% endschema %}
