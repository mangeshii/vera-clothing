
<section class="vera-about-hero">
  <div class="vera-about-hero__content">
    <p class="vera-about-hero__eyebrow">
      {{ section.settings.eyebrow | escape }}
    </p>

    <h1>{{ section.settings.heading | escape }}</h1>

    <div class="vera-about-hero__description">
      {{ section.settings.description }}
    </div>
  </div>

  {% if section.settings.image != blank %}
    <div class="vera-about-hero__image">
      {{
        section.settings.image
        | image_url: width: 1800
        | image_tag:
          loading: 'eager',
          widths: '600, 900, 1200, 1800',
          sizes: '100vw'
      }}
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .vera-about-hero {
    background: #f4f0eb;
    text-align: center;
    padding: 90px 24px;
  }

  .vera-about-hero__content {
    max-width: 850px;
    margin: 0 auto 50px;
  }

  .vera-about-hero__eyebrow {
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 12px;
    color: #977d65;
  }

  .vera-about-hero h1 {
    font-family: Georgia, serif;
    font-size: clamp(42px, 6vw, 80px);
    font-weight: 400;
    line-height: 1.1;
    margin: 24px 0;
  }

  .vera-about-hero__description {
    font-size: 18px;
    line-height: 1.8;
    color: #666;
  }

  .vera-about-hero__image {
    max-width: 1400px;
    margin: 0 auto;
    aspect-ratio: 16 / 7;
    overflow: hidden;
  }

  .vera-about-hero__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 749px) {
    .vera-about-hero {
      padding: 60px 16px;
    }

    .vera-about-hero__image {
      aspect-ratio: 4 / 5;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Vera About Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "THE VERA STORY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "Designed for the way you live."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Timeless essentials. Thoughtful details. Everyday confidence.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image"
    }
  ],
  "presets": [
    {
      "name": "Vera About Hero"
    }
  ]
}
{% endschema %}
